{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "2.1.1",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.udemy.com/*",
    "https://udemy-captions.s3.amazonaws.com/*",
    "https://*.udemycdn.com/*"
  ],
  "optional_host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "pages/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/*"
      ],
      "js": [
        "lib/common.js",
        "lib/i18n.js",
        "lib/ko.js",
        "lib/api.js",
        "lib/vtt.js",
        "content/ui.js",
        "content/library/core.js",
        "content/library/panel.js",
        "content/library/actions.js",
        "content/library/cards.js",
        "content/library/index.js",
        "content/player/core.js",
        "content/player/speed.js",
        "content/player/subs.js",
        "content/player/transcript.js",
        "content/player/lessons.js",
        "content/player/notes.js",
        "content/player/tools.js",
        "content/player/nativecc.js",
        "content/player/capbox.js",
        "content/player/bar.js",
        "content/player/index.js",
        "content/catalog.js",
        "content/diagnose.js",
        "content/main.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://support.udemy.com/*",
        "https://business-support.udemy.com/*",
        "https://blog.udemy.com/*",
        "https://about.udemy.com/*",
        "https://business.udemy.com/*",
        "https://community.udemy.com/*",
        "https://teach.udemy.com/*",
        "https://research.udemy.com/*",
        "https://investors.udemy.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmdTogglePlay__"
    },
    "seek-back": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "__MSG_cmdSeekBack__"
    },
    "seek-forward": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "__MSG_cmdSeekForward__"
    },
    "screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdScreenshot__"
    },
    "speed-up": {
      "description": "__MSG_cmdSpeedUp__"
    },
    "speed-down": {
      "description": "__MSG_cmdSpeedDown__"
    },
    "next-lecture": {
      "description": "__MSG_cmdNextLecture__"
    },
    "quick-note": {
      "description": "__MSG_cmdQuickNote__"
    }
  }
}
